// Nexnet chain app — pure transition rules (AD-1, AD-10, AD-23)
// Error codes: 0 = ok; non-zero = reject.
// Self-check in main(); executor returns 0 on pass.

const MIN_ACCOUNT_AGE_MS = 604800000
const INACTIVITY_RELEASE_MS = 7776000000
const MIN_USERNAME_LEN = 2
const MAX_USERNAME_LEN = 32

// register-username checks (AD-10 + anti-squat)
fn can_register_username(account_age_ms: Int, owns_username: Int, name_taken: Int, owner_inactive_ms: Int, name_len: Int) -> Int {
  if name_len < MIN_USERNAME_LEN {
    return 1;
  }
  if name_len > MAX_USERNAME_LEN {
    return 2;
  }
  if owns_username != 0 {
    return 3;
  }
  if account_age_ms < MIN_ACCOUNT_AGE_MS {
    return 4;
  }
  if name_taken != 0 {
    if owner_inactive_ms < INACTIVITY_RELEASE_MS {
      return 5;
    }
  }
  return 0;
}

fn can_transfer_username() -> Int {
  return 10;
}

fn can_set_group_creator(existing_creator: Int, caller_is_creator: Int) -> Int {
  if existing_creator == 0 {
    return 0;
  }
  if caller_is_creator != 0 {
    return 0;
  }
  return 11;
}

fn can_register_relay(key_len: Int) -> Int {
  if key_len <= 0 {
    return 12;
  }
  return 0;
}

fn can_bind_identity_root(already_bound: Int) -> Int {
  if already_bound != 0 {
    return 13;
  }
  return 0;
}

// AD-14: stake-ranked validators, min 4, target 7-21, power cap
const MIN_VALIDATORS = 4
const MAX_VALIDATORS = 21
const TARGET_VALIDATORS = 7

// stake_ok: 1 if bonded stake meets min bond
// set_size: current validator count after proposed join
// already_validator: 1 if already in set
fn can_join_validator_set(stake_ok: Int, set_size: Int, already_validator: Int) -> Int {
  if already_validator != 0 {
    return 20;
  }
  if stake_ok == 0 {
    return 21;
  }
  if set_size > MAX_VALIDATORS {
    return 22;
  }
  return 0;
}

// After leave, set must stay >= MIN_VALIDATORS once past bootstrap
// bootstrapping: 1 while set still forming (size was < MIN)
fn can_leave_validator_set(set_size_after: Int, bootstrapping: Int) -> Int {
  if bootstrapping != 0 {
    return 0;
  }
  if set_size_after < MIN_VALIDATORS {
    return 23;
  }
  return 0;
}

// effective_power = min(raw_stake, power_cap)
fn effective_voting_power(raw_stake: Int, power_cap: Int) -> Int {
  if raw_stake < power_cap {
    return raw_stake;
  }
  return power_cap;
}

// Identity, credential and revocation rules (wallet-primary identity)
// 30: identity id is not derived from the wallet
// 31: identity proof is not signed by the wallet
// 13: identity root already bound to another wallet
fn can_register_identity(id_matches_wallet: Int, proof_valid: Int, bound_to_other: Int) -> Int {
  if id_matches_wallet == 0 {
    return 30;
  }
  if proof_valid == 0 {
    return 31;
  }
  if bound_to_other != 0 {
    return 13;
  }
  return 0;
}

// 32: too many ssh keys, 33: duplicate, 34: revoked, 35: bad wallet signature
fn can_register_ssh_key(key_count: Int, already_registered: Int, revoked: Int, commitment_valid: Int) -> Int {
  if commitment_valid == 0 {
    return 35;
  }
  if already_registered != 0 {
    return 33;
  }
  if revoked != 0 {
    return 34;
  }
  if key_count >= 8 {
    return 32;
  }
  return 0;
}

// 36: stale sequence, 37: bad wallet signature
fn can_revoke_credential(sequence: Int, last_sequence: Int, signature_valid: Int) -> Int {
  if signature_valid == 0 {
    return 37;
  }
  if sequence < 1 {
    return 36;
  }
  if sequence <= last_sequence {
    return 36;
  }
  return 0;
}

// 38: a device certificate is dead when it, or the credential that
// authorised it, is revoked; 39: certificate expired
fn can_use_device_certificate(device_revoked: Int, authorizer_revoked: Int, expired: Int) -> Int {
  if device_revoked != 0 {
    return 38;
  }
  if authorizer_revoked != 0 {
    return 38;
  }
  if expired != 0 {
    return 39;
  }
  return 0;
}

fn main() -> Int {
  if can_register_username(604800000, 0, 0, 0, 5) != 0 {
    return 100;
  }
  if can_register_username(1000, 0, 0, 0, 5) != 4 {
    return 101;
  }
  if can_register_username(604800000, 1, 0, 0, 5) != 3 {
    return 102;
  }
  if can_register_username(604800000, 0, 1, 1000, 5) != 5 {
    return 103;
  }
  if can_register_username(604800000, 0, 1, 7776000000, 5) != 0 {
    return 104;
  }
  if can_register_username(604800000, 0, 0, 0, 1) != 1 {
    return 105;
  }
  if can_transfer_username() != 10 {
    return 106;
  }
  if can_set_group_creator(0, 0) != 0 {
    return 107;
  }
  if can_set_group_creator(1, 0) != 11 {
    return 108;
  }
  if can_register_relay(0) != 12 {
    return 109;
  }
  if can_bind_identity_root(1) != 13 {
    return 110;
  }
  if can_join_validator_set(1, 5, 0) != 0 {
    return 111;
  }
  if can_join_validator_set(0, 5, 0) != 21 {
    return 112;
  }
  if can_join_validator_set(1, 22, 0) != 22 {
    return 113;
  }
  if can_leave_validator_set(3, 0) != 23 {
    return 114;
  }
  if can_leave_validator_set(3, 1) != 0 {
    return 115;
  }
  if effective_voting_power(100, 50) != 50 {
    return 116;
  }
  if effective_voting_power(10, 50) != 10 {
    return 117;
  }
  if can_register_identity(1, 1, 0) != 0 {
    return 120;
  }
  if can_register_identity(0, 1, 0) != 30 {
    return 121;
  }
  if can_register_identity(1, 0, 0) != 31 {
    return 122;
  }
  if can_register_identity(1, 1, 1) != 13 {
    return 123;
  }
  if can_register_ssh_key(0, 0, 0, 1) != 0 {
    return 124;
  }
  if can_register_ssh_key(8, 0, 0, 1) != 32 {
    return 125;
  }
  if can_register_ssh_key(1, 1, 0, 1) != 33 {
    return 126;
  }
  if can_register_ssh_key(1, 0, 1, 1) != 34 {
    return 127;
  }
  if can_register_ssh_key(1, 0, 0, 0) != 35 {
    return 128;
  }
  if can_revoke_credential(2, 1, 1) != 0 {
    return 129;
  }
  if can_revoke_credential(1, 1, 1) != 36 {
    return 130;
  }
  if can_revoke_credential(0, 0, 1) != 36 {
    return 131;
  }
  if can_revoke_credential(2, 1, 0) != 37 {
    return 132;
  }
  if can_use_device_certificate(0, 0, 0) != 0 {
    return 133;
  }
  if can_use_device_certificate(1, 0, 0) != 38 {
    return 134;
  }
  if can_use_device_certificate(0, 1, 0) != 38 {
    return 135;
  }
  if can_use_device_certificate(0, 0, 1) != 39 {
    return 136;
  }
  return 0;
}
